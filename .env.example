# Sao chép file này thành .env rồi điền API key (file .env đã nằm trong .gitignore)
GEMINI_API_KEY=
# Danh sách model thử lần lượt (model sau là dự phòng khi model trước quá tải / ngừng hỗ trợ)
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3.8-flash
CHROMA_COLLECTION=soict_admission
